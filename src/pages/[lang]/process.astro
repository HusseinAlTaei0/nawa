---
/** صفحة طريقة العمل: المراحل الست على خط مدار، ثم طرق العمل الثلاث */
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Stages from '../../components/Stages.astro';
import Closing from '../../components/Closing.astro';
import { processData, home } from '../../data/pages';
import { ui, gold } from '../../i18n/ui';
import { LANGS, type Lang } from '../../config/site';
import { showDrafts } from '../../lib/drafts';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const p = processData[lang], t = ui[lang];
---
<Base lang={lang} title={p.title} description={p.lead}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{p.eyebrow}</p>
      <h1 data-reveal style="--i:1" set:html={gold(p.title)} />
      <p class="lead" data-reveal style="--i:2">{p.lead}</p>
    </div>
  </section>
  <section class="section band" style="padding-block-start:clamp(40px,6vh,72px)">
    <div class="wrap">
      <Stages lang={lang} />
      {showDrafts && <p class="muted" style="margin-block-start:20px;font-size:.85rem">* {t.sampleNote}</p>}
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={p.models.eyebrow} title={p.models.title} />
      <div class="grid-3 hair" data-reveal>
        {p.models.items.map((it) => <div><h3>{it.name}</h3><p>{it.text}</p></div>)}
      </div>
    </div>
  </section>
  <Closing lang={lang} title={home[lang].closing.title} text={home[lang].closing.text} />
</Base>
