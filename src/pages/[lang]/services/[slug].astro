---
/**
 * صفحة الخدمة (قالب واحد للخدمات الست):
 * Hero + كوكب الخدمة → مشكلات نحلّها → ماذا تستلم → كيف يعمل → أين يناسب
 * → المدة (تجريبية) والسعر → حدود صريحة → أسئلة → خدمات أخرى → نداء الختام برسالة واتساب جاهزة
 */
import Base from '../../../layouts/Base.astro';
import PlanetButton from '../../../components/PlanetButton.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Planet from '../../../components/Planet.astro';
import Faq from '../../../components/Faq.astro';
import Closing from '../../../components/Closing.astro';
import { services } from '../../../data/services';
import { servicesPage, home } from '../../../data/pages';
import { ui, path, gold } from '../../../i18n/ui';
import { LANGS, whatsappLink, type Lang } from '../../../config/site';
import { showDrafts } from '../../../lib/drafts';

export function getStaticPaths() {
  return LANGS.flatMap((lang) => services.map((s) => ({ params: { lang, slug: s.slug } })));
}
const lang = Astro.params.lang as Lang;
const svc = services.find((s) => s.slug === Astro.params.slug)!;
const s = svc[lang], t = ui[lang], L = servicesPage[lang].labels;
const others = services.filter((x) => x.slug !== svc.slug);
---
<Base lang={lang} title={s.name} description={s.outcome}>
  <section class="page-hero svc-hero">
    <div class="wrap">
      <div class="copy">
        <p class="eyebrow" data-reveal><a href={path(lang, 'services')}>{servicesPage[lang].eyebrow}</a> · {s.name}</p>
        <h1 data-reveal style="--i:1" set:html={gold(s.title)} />
        <p class="lead" data-reveal style="--i:2">{s.intro}</p>
        <div class="ctas" data-reveal style="--i:3">
          <PlanetButton href={path(lang, 'contact') + `?service=${svc.slug}`} label={t.cta} />
          <PlanetButton href={whatsappLink(s.wa)} label={L.ask} variant="ghost" external />
        </div>
      </div>
      <Planet name={svc.planet} sizes="(max-width: 900px) 64vw, 440px" eager />
    </div>
  </section>

  <section class="section band">
    <div class="wrap grid-2">
      <div data-reveal>
        <SectionHead title={L.problems} />
        <ul class="check x">{s.problems.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div data-reveal>
        <SectionHead title={L.deliverables} />
        <ul class="check solid">{s.deliverables.map((p) => <li>{p}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead title={L.how} />
      <ol class="flow" data-reveal>
        {s.flow.map((f) => <li><span class="dot" aria-hidden="true"><i></i></span><p>{f}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <SectionHead title={L.sectors} />
      <div class="grid-3 hair" data-reveal>
        {s.sectors.map((x) => <div><h3>{x.name}</h3><p>{x.text}</p></div>)}
      </div>
      <div class="spec hair" style="margin-block-start:1px;border-block-start:0" data-reveal>
        {showDrafts && <div data-draft><p class="eyebrow">{L.timeline} · {t.sample}</p><h3><bdi>{s.timeline}</bdi></h3></div>}
        <div><p class="eyebrow">{L.price}</p><p>{L.priceText}</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid-2">
      <div data-reveal>
        <SectionHead title={L.limits} lead={L.limitsLead} />
        <ul class="check">{s.limits.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <SectionHead title={L.faq} />
        <Faq items={s.faq} />
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <SectionHead title={L.other} />
      <div class="svc-rows">
        {others.map((o) => (
          <a class="svc-row" href={path(lang, `services/${o.slug}`)} data-reveal>
            <span class="idx" aria-hidden="true">·</span>
            <h3>{o[lang].name}</h3>
            <p>{o[lang].outcome}</p>
            <span class="tlink">{t.more} <span class="arrow" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Closing lang={lang} title={home[lang].closing.title} text={home[lang].closing.text} wa={s.wa} />
</Base>
