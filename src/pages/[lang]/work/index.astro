---
/**
 * صفحة الأعمال: بطاقات دراسات الحالة (المشكلة → النظام → النتيجة).
 * إذا لم توجد دراسات معتمدة (draft: false) يظهر في الموقع الحي نص صريح بدل أرقام مختلقة.
 */
import Base from '../../../layouts/Base.astro';
import PlanetButton from '../../../components/PlanetButton.astro';
import DraftTag from '../../../components/DraftTag.astro';
import Closing from '../../../components/Closing.astro';
import { workPage, home } from '../../../data/pages';
import { ui, path, gold } from '../../../i18n/ui';
import { LANGS, whatsappLink, type Lang } from '../../../config/site';
import { getWork, workSlug } from '../../../lib/work';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = ui[lang], c = workPage[lang];
const work = await getWork(lang);
const anyDraft = work.some((w) => w.data.draft);
---
<Base lang={lang} title={c.title} description={c.lead}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>{c.eyebrow}</p>
      <h1 data-reveal style="--i:1" set:html={gold(c.title)} />
      <p class="lead" data-reveal style="--i:2">{c.lead}</p>
    </div>
  </section>
  <section class="section" style="padding-block-start:0">
    <div class="wrap">
      {work.length === 0 ? (
        <div class="empty" data-reveal>
          <h2>{c.emptyTitle}</h2>
          <p>{c.emptyText}</p>
          <PlanetButton href={whatsappLink(t.waDefault)} label={t.whatsapp} variant="ghost" external />
        </div>
      ) : (
        <>
          {anyDraft && <p style="margin-block-end:16px"><DraftTag lang={lang} /></p>}
          <div class="work-grid">
            {work.map((w) => (
              <a class="work-tile" href={path(lang, `work/${workSlug(w)}`)} data-reveal>
                <p class="eyebrow">{w.data.sector} · <bdi dir="ltr">{w.data.year}</bdi></p>
                <p class="metric"><bdi>{w.data.metric}</bdi></p>
                <p>{w.data.metricLabel}</p>
                <h2 style="font-size:var(--fs-h3)">{w.data.title}</h2>
                <p class="muted">{w.data.summary}</p>
                <span class="tlink">{t.more} <span class="arrow" aria-hidden="true">→</span></span>
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>
  <Closing lang={lang} title={home[lang].closing.title} text={home[lang].closing.text} />
</Base>
