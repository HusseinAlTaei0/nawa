---
/**
 * الصفحة الرئيسية:
 * Hero (كوكب النجوم الذهبية) → أرقام (تجريبية) → الخدمات (كروت الكواكب) → أعمال (تجريبية)
 * → طريقة العمل → المبادئ → بغداد من المدار → الأسئلة → نداء الختام
 */
import Base from '../../layouts/Base.astro';
import PlanetButton from '../../components/PlanetButton.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceRail from '../../components/ServiceRail.astro';
import Stages from '../../components/Stages.astro';
import Globe from '../../components/Globe.astro';
import Faq from '../../components/Faq.astro';
import Closing from '../../components/Closing.astro';
import DraftTag from '../../components/DraftTag.astro';
import { home } from '../../data/pages';
import { ui, path, gold } from '../../i18n/ui';
import { LANGS, whatsappLink, type Lang } from '../../config/site';
import { showDrafts } from '../../lib/drafts';
import { getWork, workSlug } from '../../lib/work';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const t = ui[lang], c = home[lang];
const work = (await getWork(lang)).slice(0, 2);
---
<Base lang={lang}>
  <section class="hero">
    <canvas class="hero-planet" aria-hidden="true"></canvas>
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow" data-reveal>{c.eyebrow}</p>
        <h1 class="display" data-reveal style="--i:1" set:html={gold(c.title)} />
        <p class="lead" data-reveal style="--i:2">{c.sub}</p>
        <div class="ctas" data-reveal style="--i:3">
          <PlanetButton href={path(lang, 'contact')} label={t.cta} />
          <PlanetButton href={whatsappLink(t.waDefault)} label={t.whatsapp} variant="ghost" external />
        </div>
      </div>
    </div>
  </section>

  {showDrafts && (
    <section class="section" data-draft style="padding-block: 0 var(--section)">
      <div class="wrap" style="display:flex;flex-direction:column;gap:14px">
        <DraftTag lang={lang} />
        <div class="proof hair" data-reveal>
          {c.proof.map((p) => (
            <div><p class="v"><bdi>{p.value}</bdi></p><p>{p.label}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <ServiceRail lang={lang} />

  {work.length > 0 && (
    <section class="section" data-draft={work.some((w) => w.data.draft) ? '' : undefined}>
      <div class="wrap">
        <SectionHead eyebrow={c.work.eyebrow} title={c.work.title} />
        {work.some((w) => w.data.draft) && <p style="margin-block-end:16px"><DraftTag lang={lang} /></p>}
        <div class="work-grid">
          {work.map((w) => (
            <a class="work-tile" href={path(lang, `work/${workSlug(w)}`)} data-reveal>
              <p class="eyebrow">{w.data.sector} · <bdi dir="ltr">{w.data.year}</bdi></p>
              <p class="metric"><bdi>{w.data.metric}</bdi></p>
              <p>{w.data.metricLabel}</p>
              <h3>{w.data.title}</h3>
              <span class="tlink">{t.more} <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section band">
    <div class="wrap">
      <SectionHead eyebrow={c.process.eyebrow} title={c.process.title} lead={c.process.lead} />
      <Stages lang={lang} compact />
      <p style="margin-block-start:28px" data-reveal><a class="tlink" href={path(lang, 'process')}>{c.process.link} <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={c.principles.eyebrow} title={c.principles.title} />
      <div class="grid-4 hair" data-reveal>
        {c.principles.items.map((p) => (
          <div><h3>{p.name}</h3><p>{p.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <Globe lang={lang} />

  <section class="section band">
    <div class="wrap">
      <SectionHead eyebrow={c.faq.eyebrow} title={c.faq.title} />
      <Faq items={c.faq.items} />
    </div>
  </section>

  <Closing lang={lang} title={c.closing.title} text={c.closing.text} />
</Base>
<script>
  import '../../scripts/heroplanet.ts';
</script>
