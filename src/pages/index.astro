 */
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>NAWA</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <link rel="canonical" href="https://nawa-iq.com/en/" />
    <style>body{background:#0a0a0a;color:#fff;font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0}a{color:#ddc288}</style>
  </head>
  <body>
    <p><a href="/en/">English</a> · <a href="/ar/" lang="ar">العربية</a></p>
  </body>
</html>
