---
/**
 * "بغداد من المدار": كرة أرضية داكنة بنقاط بيضاء، وأقواس ذهبية متحركة من بغداد إلى مدن العالم، وأسماء المدن عند المرور.
 * السلوك في src/scripts/globe.ts. الصندوق زخرفي (aria-hidden) والمعلومة نفسها مكتوبة في النص بجانبه.
 */
import { home } from '../data/pages';
import { gold } from '../i18n/ui';
import type { Lang } from '../config/site';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = home[lang].place;
---
<section class="section place">
  <div class="wrap">
    <div class="copy" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 set:html={gold(c.title)} />
      <p class="lead">{c.text}</p>
      <p class="cities">{c.cities}</p>
    </div>
    <div class="globe-box" data-globe aria-hidden="true">
      <div class="fallback"></div>
      <canvas class="globe-earth"></canvas>
      <canvas class="globe-arcs"></canvas>
      <!-- اسم المدينة عند المرور (زخرفي، داخل صندوق aria-hidden) -->
      <span class="globe-label"></span>
    </div>
  </div>
</section>
<script>
  import '../scripts/globe.ts';
</script>
