---
/** مراحل العمل الست على خط مدار عمودي. compact = نسخة مختصرة للصفحة الرئيسية */
import { processData } from '../data/pages';
import { showDrafts } from '../lib/drafts';
import type { Lang } from '../config/site';
interface Props { lang: Lang; compact?: boolean; }
const { lang, compact = false } = Astro.props;
const p = processData[lang];
---
<ol class:list={['stages', compact && 'compact']}>
  {p.stages.map((s, i) => (
    <li class="stage" data-reveal style={`--i:${compact ? i : 0}`}>
      <span class="pin" aria-hidden="true"><i></i></span>
      <div class="body">
        <div>
          <h3>{s.name}</h3>
          {!compact && <p>{s.text}</p>}
        </div>
        {compact ? <p>{s.text}</p> : (
          <dl>
            <dt>{p.get}</dt><dd>{s.get}</dd>
            <dt>{p.need}</dt><dd>{s.need}</dd>
            {showDrafts && <><dt data-draft>{p.typical} *</dt><dd><bdi>{s.duration}</bdi></dd></>}
          </dl>
        )}
      </div>
    </li>
  ))}
</ol>
