---
/** أسئلة شائعة بعناصر <details> الأصلية (تعمل بدون JavaScript وبلوحة المفاتيح) */
interface Props { items: readonly { q: string; a: string }[]; }
const { items } = Astro.props;
---
<div class="faq" data-reveal>
  {items.map((it) => (
    <details>
      <summary>{it.q}</summary>
      <p>{it.a}</p>
    </details>
  ))}
</div>
